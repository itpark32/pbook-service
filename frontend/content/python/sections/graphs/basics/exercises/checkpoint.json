  "kind": "checkpoint",
  "title": "Вершины без рёбер",
  "statement": "По степеням найдите, сколько вершин не участвует ни в одном ребре.\n\nТренируемый приём: список смежности.",
  "difficulty": "challenge",
  "starterCode": "def degrees(...):\n    pass\n",
  "hints": [
    "Определите, какие данные нужны для шага «список смежности».",
    "Проследите решение на одном небольшом примере вручную.",
    "Проверьте крайний случай из тестов до отправки."
  ],
  "solution": "def degrees(n, edges):\n    result = [0] * n\n    for left, right in edges:\n        result[left] += 1\n        result[right] += 1\n    return result",
  "examples": [
    {
      "input": "[4,[[0,1],[1,2]]]",
      "output": "[1,2,1,0]"
    }
  ],
  "judge": {
    "type": "function",
    "functionName": "degrees",
    "tests": [
      {
        "args": [
          4,
          [
            [
              0,
              1
            ],
            [
              1,
              2
            ]
          ]
        ],
        "expectedReturn": [
          1,
          2,
          1,
          0
        ]
      },
      {
        "args": [
          0,
          []
        ],
        "expectedReturn": []
      },
      {
        "args": [
          4,
          [
            [
              0,
              1
            ],
            [
              1,
              2
            ]
          ]
        ],
        "expectedReturn": [
          1,
          2,
          1,
          0
        ]
      }
    ]
  }
}
