  "kind": "practicum",
  "title": "5. Максимум последовательности",
  "statement": "В первой строке N > 0, во второй N чисел. Найдите максимум.",
  "difficulty": "intro",
  "starterCode": "",
  "hints": [
    "Разберите входные данные до вычислений.",
    "Проверьте решение на граничном примере."
  ],
  "solution": "n = int(input())\nvalues = list(map(int, input().split()))\nmaximum = values[0]\nfor value in values[1:n]:\n    if value > maximum:\n        maximum = value\nprint(maximum)",
  "examples": [
    {
      "input": "5\n-3 8 2 8 1\n",
      "output": "8\n"
    }
  ],
  "judge": {
    "type": "stdin_stdout",
    "comparison": {
      "mode": "normalized_text"
    },
    "tests": [
      {
        "input": "5\n-3 8 2 8 1\n",
        "expectedOutput": "8\n"
      },
      {
        "input": "1\n-7\n",
        "expectedOutput": "-7\n"
      }
    ]
  }
}
