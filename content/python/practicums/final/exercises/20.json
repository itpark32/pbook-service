  "title": "20. Сумма от 1 до N",
  "statement": "Дано N ≥ 0. Выведите сумму целых чисел от 1 до N.",
  "difficulty": "challenge",
  "starterCode": "",
  "hints": [
    "Разберите входные данные до вычислений.",
    "Проверьте решение на граничном примере."
  ],
  "solution": "n = int(input())\ntotal = 0\nfor value in range(1, n + 1):\n    total += value\nprint(total)",
  "examples": [
    {
      "input": "5\n",
      "output": "15\n"
    }
  ],
  "judge": {
    "type": "stdin_stdout",
    "comparison": {
      "mode": "normalized_text"
    },
    "tests": [
      {
        "input": "5\n",
        "expectedOutput": "15\n"
      },
      {
        "input": "0\n",
        "expectedOutput": "0\n"
      }
    ]
  }
}
