  "title": "5. соседи вершин",
  "statement": "Практикум: соседи вершин. Постройте список смежности и по его длинам определите число соседей каждой вершины.\n\nТренируемый приём: список смежности.",
  "difficulty": "standard",
  "starterCode": "def degrees(...):\n    pass\n",
  "hints": [
    "Сначала вспомните основной приём: соседи вершин.",
    "Запустите решение на обычном и граничном примере.",
    "Сверьте формат результата с условием, а не с пояснениями."
  ],
  "solution": "def degrees(n, edges):\n    result = [0] * n\n    for left, right in edges:\n        result[left] += 1\n        result[right] += 1\n    return result",
  "examples": [
    {
      "input": "[4,[[0,1],[1,2]]]",
      "output": "[1,2,1,0]"
    }
  ],
  "judge": {
    "type": "function",
    "functionName": "degrees",
    "tests": [
      {
        "args": [
          4,
          [
            [
              0,
              1
            ],
            [
              1,
              2
            ]
          ]
        ],
        "expectedReturn": [
          1,
          2,
          1,
          0
        ]
      },
      {
        "args": [
          0,
          []
        ],
        "expectedReturn": []
      },
      {
        "args": [
          4,
          [
            [
              0,
              1
            ],
            [
              1,
              2
            ]
          ]
        ],
        "expectedReturn": [
          1,
          2,
          1,
          0
        ]
      }
    ]
  }
}
