          2,
          5
        ],
        "expectedReturn": 32
      },
      {
        "args": [
          9,
          0
        ],
        "expectedReturn": 1
      }
    ],
    "structuralConstraints": {
      "requireRecursion": [
        "power"
      ]
    }
  }
