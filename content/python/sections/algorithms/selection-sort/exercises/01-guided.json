  "kind": "guided",
  "title": "Минимум в хвосте",
  "statement": "Верните индекс минимального элемента списка начиная с позиции start.",
  "difficulty": "intro",
  "starterCode": "def minimum_index(...):\n    pass\n",
  "hints": [
    "Сначала сформулируйте, что функция должна вернуть.",
    "Проверьте пустые и граничные данные."
  ],
  "solution": "def minimum_index(values, start):\n    smallest = start\n    for i in range(start + 1, len(values)):\n        if values[i] < values[smallest]:\n            smallest = i\n    return smallest",
  "examples": [
    {
      "input": "[[5,2,7,1],1]",
      "output": "3"
    }
  ],
  "judge": {
    "type": "function",
    "functionName": "minimum_index",
    "tests": [
      {
        "args": [
          [
            5,
            2,
            7,
            1
          ],
          1
        ],
        "expectedReturn": 3
      },
      {
        "args": [
          [
            3
          ],
          0
        ],
        "expectedReturn": 0
      }
    ],
    "structuralConstraints": {
      "forbidCalls": [
        "sorted"
      ],
      "forbidMethods": [
        "sort"
      ]
    }
  }
