  "kind": "guided",
  "title": "Чётное или нечётное",
  "statement": "Выведите `even` для чётного числа и `odd` для нечётного.",
  "difficulty": "standard",
  "starterCode": "",
  "hints": [
    "Разберите входные данные до вычислений.",
    "Проверьте решение на граничном примере."
  ],
  "solution": "n = int(input())\nif n % 2 == 0:\n    print('even')\nelse:\n    print('odd')",
  "examples": [
    {
      "input": "8\n",
      "output": "even\n"
    }
  ],
  "judge": {
    "type": "stdin_stdout",
    "comparison": {
      "mode": "normalized_text"
    },
    "tests": [
      {
        "input": "8\n",
        "expectedOutput": "even\n"
      },
      {
        "input": "-3\n",
        "expectedOutput": "odd\n"
      },
      {
        "input": "0\n",
        "expectedOutput": "even\n"
      }
    ]
  }
}
