  "id": "python-loops-for-range-guided-2",
  "owner": {
    "type": "lesson",
    "id": "python-loops-for-range"
  },
  "kind": "guided",
  "title": "Количество кратных",
  "statement": "Даны N и K. Посчитайте числа от 1 до N, кратные K.",
  "difficulty": "standard",
  "starterCode": "",
  "hints": [
    "Разберите входные данные до вычислений.",
    "Проверьте решение на граничном примере."
  ],
  "solution": "n, k = map(int, input().split())\ncount = 0\nfor value in range(1, n + 1):\n    if value % k == 0:\n        count += 1\nprint(count)",
  "examples": [
    {
      "input": "10 3\n",
      "output": "3\n"
    }
  ],
  "judge": {
    "type": "stdin_stdout",
    "comparison": {
      "mode": "normalized_text"
    },
    "tests": [
      {
        "input": "10 3\n",
        "expectedOutput": "3\n"
      },
      {
        "input": "4 9\n",
        "expectedOutput": "0\n"
      }
    ]
  }
}
