  "kind": "checkpoint",
  "title": "Сумма двух чисел",
  "statement": "Прочитайте два целых числа из одной строки и выведите их сумму.",
  "difficulty": "challenge",
  "starterCode": "",
  "hints": [
    "Разберите входные данные до вычислений.",
    "Проверьте решение на граничном примере."
  ],
  "solution": "a, b = map(int, input().split())\nprint(a + b)",
  "examples": [
    {
      "input": "2 3\n",
      "output": "5\n"
    }
  ],
  "judge": {
    "type": "stdin_stdout",
    "comparison": {
      "mode": "normalized_text"
    },
    "tests": [
      {
        "input": "2 3\n",
        "expectedOutput": "5\n"
      },
      {
        "input": "-4 9\n",
        "expectedOutput": "5\n"
      },
      {
        "input": "0 0\n",
        "expectedOutput": "0\n"
      }
    ]
  }
}
