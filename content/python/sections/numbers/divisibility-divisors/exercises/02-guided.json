  "kind": "guided",
  "title": "Простое число",
  "statement": "Верните True, если n — простое число.",
  "difficulty": "standard",
  "starterCode": "def is_prime(...):\n    pass\n",
  "hints": [
    "Сначала сформулируйте, что функция должна вернуть.",
    "Проверьте пустые и граничные данные."
  ],
  "solution": "def is_prime(n):\n    if n < 2:\n        return False\n    divisor = 2\n    while divisor * divisor <= n:\n        if n % divisor == 0:\n            return False\n        divisor += 1\n    return True",
  "examples": [
    {
      "input": "[2]",
      "output": "true"
    }
  ],
  "judge": {
    "type": "function",
    "functionName": "is_prime",
    "tests": [
      {
        "args": [
          2
        ],
        "expectedReturn": true
      },
      {
        "args": [
          17
        ],
        "expectedReturn": true
      },
      {
        "args": [
          21
        ],
        "expectedReturn": false
      },
      {
        "args": [
          1
        ],
        "expectedReturn": false
      }
    ]
  }
